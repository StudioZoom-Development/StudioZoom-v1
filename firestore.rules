rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin()          { return isSignedIn() && getRole() == 'admin'; }
    function isManager()        { return isSignedIn() && getRole() == 'manager'; }
    function isAdminOrManager() { return isAdmin() || isManager(); }

    match /users/{uid} {
      // Any signed-in user can read user profiles (for team assignments, author info & pickers)
      allow read:   if isSignedIn();
      allow write:  if isAdmin();
      allow delete: if false;
    }

    match /clients/{clientId} {
      allow read:        if isSignedIn();
      allow write:       if isAdminOrManager();
      allow delete:      if isAdmin();
      match /payments/{paymentId} {
        allow read:        if isSignedIn();
        allow write:       if isAdminOrManager();
      }
    }

    // Collection group rule for cross-client payments query
    match /{path=**}/payments/{paymentId} {
      allow read:        if isSignedIn();
      allow write:       if isAdminOrManager();
    }

    match /bookingDrafts/{draftId} {
      // Allow signed-in staff/managers/admins to save and resume booking drafts
      allow read, write: if isSignedIn();
    }

    match /leads/{leadId} {
      allow read, write: if isAdminOrManager();
      allow delete:      if isAdmin();
    }

    match /projects/{projectId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrManager() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postProduction', 'updatedAt'])
      );
    }

    match /staffAssignments/{assignmentId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrManager();
    }

    match /workItems/{workItemId} {
      allow read:   if isSignedIn();
      allow delete: if isAdminOrManager();
      allow create: if isSignedIn();
      allow update: if isAdminOrManager() || (
        isSignedIn() &&
        (resource.data.assignedToUid == request.auth.uid || request.resource.data.assignedToUid == request.auth.uid)
      );
    }

    match /equipment/{itemId} {
      allow read:  if isSignedIn();
      // Admins/managers have full write permissions
      // Signed-in staff can update custody and status fields during checkout / check-in
      allow write: if isAdminOrManager() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedToUid', 'assignedToName', 'currentCheckoutId',
          'dueBackDate', 'lastUsedDate', 'updatedAt', 'condition'
        ])
      );

      match /statusLogs/{logId} {
        allow read, write: if isSignedIn();
      }
    }

    match /equipmentKits/{kitId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrManager();
    }

    match /checkouts/{checkoutId} {
      allow read:  if isSignedIn();
      // Allow signed-in staff, managers, and admins to record checkouts and returns
      allow write: if isSignedIn();
    }

    match /attendance/{attendanceId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrManager();
    }

    match /timeLogs/{logId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.staffUid || isAdminOrManager()
      );
      // Staff can create their own check-in record, or Admins/Managers can create
      allow create: if isAdminOrManager() || (
        isSignedIn() && request.resource.data.staffUid == request.auth.uid
      );
      // Staff can update only their own open sessions (check-out)
      allow update: if isAdminOrManager() || (
        isSignedIn() &&
        resource.data.staffUid == request.auth.uid &&
        resource.data.status == 'open'
      );
      allow delete: if isAdminOrManager();
    }

    match /timeLogCorrections/{correctionId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.staffUid || isAdminOrManager()
      );
      allow write: if isAdminOrManager();
    }

    match /leaveRequests/{requestId} {
      allow read: if isSignedIn();
      // Staff can submit their own leave/permission requests, or Admins/Managers can create
      allow create: if isAdminOrManager() || (
        isSignedIn() && request.resource.data.staffUid == request.auth.uid
      );
      // Admins/managers can review/approve/reject requests
      allow update, delete: if isAdminOrManager();
    }

    match /salaries/{salaryId}    { allow read, write: if isAdminOrManager(); }
    match /payslips/{payslipId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.staffUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /freelancers/{freelancerId}   { allow read, write: if isAdminOrManager(); }
    match /freelancerPayouts/{payoutId} { allow read, write: if isAdmin(); }
    match /expenses/{expenseId}         { allow read, write: if isAdmin(); }
    match /expenseCategories/{categoryId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrManager();
    }
    match /budgets/{budgetId}           { allow read, write: if isAdmin(); }
    match /payables/{payableId}         { allow read, write: if isAdmin(); }
    match /quotations/{quotationId}     { allow read, write: if isAdminOrManager(); }
    match /invoices/{invoiceId}         { allow read, write: if isAdminOrManager(); }

    match /studioSettings/{doc} {
      allow read:  if isSignedIn();
      // Allow managers and admins to update numbering counters and runtime config
      allow write: if isAdminOrManager();
    }

    match /saved_addresses/{addressId} {
      allow read:  if isSignedIn();
      allow write: if isAdminOrManager();
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }
  }
}

